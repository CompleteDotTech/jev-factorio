flowchart TD

subgraph JEV["5. Jev candidate judgment"]
    JEV_BATCH["Build one independent question batch<br/>Facts, active goal and last eight history events<br/>Up to 16 candidate plans"]
    SIZE{"Serialized request at most 32000 bytes?"}
    TRIM["Drop final candidate and rebuild<br/>No candidates left means no valid decision"]
    QUESTIONS["Ask candidate choice plus, for EACH plan:<br/>benefit score 0–2<br/>disruption score 0–2<br/>needs-observation value 0–1"]
    API["Call Jev once for the batch"]
    API_RESULT{"Provider result?"}
    ANSWER_VALID{"Exact answer keys and types?<br/>Finite scores and confidences?<br/>Valid probability distributions?<br/>Choice and score consistency?"}
    GLOBAL_GATE{"Model chose observe<br/>or choice confidence below 0.45?"}
    PER_PLAN["Exclude each candidate if:<br/>needs-observation at least 0.5<br/>or benefit/disruption confidence below 0.45"]
    UTILITY["Rank remaining candidates:<br/>choice probability + benefit / 4<br/>minus disruption / 8<br/>minus 0.02 per step"]
    WINNER{"At least one eligible candidate?"}
    JEV_CHOSEN["Select maximum-utility candidate"]
    NO_DECISION["No usable model decision"]
    FALLBACK_POLICY{"Hybrid policy?"}
    FALLBACK["Deterministic fallback over available plans<br/>Minimum step count, then plan ID"]
    STALL["Strict Jev: observe only<br/>Increment stalled-decision count"]
    STALL_LIMIT{"Four stalled decisions reached?"}

    JEV_BATCH --> SIZE
    SIZE -->|No| TRIM
    TRIM -->|Candidates remain| JEV_BATCH
    TRIM -->|None remain| NO_DECISION
    SIZE -->|Yes| QUESTIONS --> API --> API_RESULT
    API_RESULT -->|Timeout, connection error, HTTP 408/429/5xx| NO_DECISION
    API_RESULT -->|Other unhandled error| GAME_ERROR
    API_RESULT -->|Answers received| ANSWER_VALID
    ANSWER_VALID -->|No| NO_DECISION
    ANSWER_VALID -->|Yes| GLOBAL_GATE
    GLOBAL_GATE -->|Yes| NO_DECISION
    GLOBAL_GATE -->|No| PER_PLAN --> UTILITY --> WINNER
    WINNER -->|Yes| JEV_CHOSEN --> COMMIT
    WINNER -->|No| NO_DECISION
    NO_DECISION --> FALLBACK_POLICY
    FALLBACK_POLICY -->|Yes| FALLBACK --> COMMIT
    FALLBACK_POLICY -->|No| STALL --> STALL_LIMIT
    STALL_LIMIT -->|Yes| BLOCKED
    STALL_LIMIT -->|No| RECORD
end


    BLOCKED["Mark blocked<br/>Record exact blocker"]
    COMMIT["Commit selected plan and step index<br/>Persist checkpoint"]
    GAME_ERROR["Unhandled controller or backend failure"]
    RECORD["Save checkpoint and append audit log<br/>Facts, decision, model usage, outcome,<br/>pending state and verification"]
classDef continuation fill:#fff7ed,stroke:#c2410c,stroke-dasharray:5 4;
class BLOCKED,COMMIT,GAME_ERROR,RECORD continuation;
