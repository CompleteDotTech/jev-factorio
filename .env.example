# Direct TypeSafe API (key from the TypeSafe console / dashboard; access is waitlist-gated)
TYPESAFE_API_KEY=
# OR route through Vercel AI Gateway (model typesafe-ai/jev, $0.042/1M input tokens, no waitlist)
AI_GATEWAY_API_KEY=
JEV_BACKEND=mock          # mock | play_api | fle
JEV_CONFIDENCE_FLOOR=0.45 # below this, the scripted fallback policy acts instead
JEV_TICK_SECONDS=2.0      # macro-decision cadence
# OR route through Cloudflare Workers AI (typesafe/jev; needs prepaid AI Gateway credits)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Dedicated Factorio server, accessed through the local SSH tunnel
FACTORIO_RCON_HOST=127.0.0.1
FACTORIO_RCON_PORT=27018
FACTORIO_RCON_PASSWORD=
# Optional JSONL decision and before/after-state log
JEV_LOG_FILE=
# Optional new, exclusive research evidence directory; choose a fresh path per invocation.
# Leave unset for supervised campaigns until per-launch directory rotation is supported.
JEV_RUN_DIR=
